# ChatBucket dedicated-server environment configuration.
#
# Copy to /etc/chatbucket/chatbucket.env (mode 0640, owned by the
# chatbucket service user) and reference from the systemd unit's
# EnvironmentFile= directive. NEVER commit real values to source control.

# ── Bind address ───────────────────────────────────────────────────────
# 0.0.0.0 exposes ChatBucket directly on the public Internet on port 5000.
# When you put Caddy/nginx in front for HTTPS, flip this to 127.0.0.1 and
# bump CHATBUCKET_PROXY_HOPS=1.
CHATBUCKET_HOST=0.0.0.0
CHATBUCKET_PORT=5000

# ── Reverse proxy hop count ────────────────────────────────────────────
# 0 = ChatBucket faces the public Internet directly (no proxy in front).
# 1 = one trusted reverse proxy (Caddy, nginx, Cloudflare Tunnel).
# Enables Werkzeug's ProxyFix so request.remote_addr / .is_secure reflect
# the real client instead of 127.0.0.1.
CHATBUCKET_PROXY_HOPS=0

# ── Optional outbound proxy for yt-dlp ─────────────────────────────────
# Only set this if YouTube egress from the VM is blocked or throttled.
# Formats: socks5://user:pass@host:port  or  http://host:port
# CHATBUCKET_YTDLP_PROXY=socks5://127.0.0.1:1080

# ── Giphy API key ──────────────────────────────────────────────────────
# server.py ships with a public demo key; replace with your own to avoid
# rate limits.
# GIPHY_API_KEY=your-giphy-key-here

# ── Firebase / FCM push notifications ──────────────────────────────────
# push_notifications.py accepts EITHER (a) the JSON payload inline, or
# (b) a filesystem path to the service-account JSON. Pick one.
#
# (a) Inline (single line, escape newlines in the private key as \n):
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account", ...}
#
# (b) Path (recommended — keeps the private key off the process env):
# GOOGLE_APPLICATION_CREDENTIALS=/etc/chatbucket/fcm_service_account.json
